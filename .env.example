########################################
# REQUIRED — app won't start without these
########################################

# Postgres connection. Matches docker-compose.yml if you use `docker compose up -d`.
DATABASE_URL="postgresql://shipflow:shipflow@localhost:5432/shipflow"

# Base URL the app is served from.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"

# Random 32+ char secret used to sign auth sessions/cookies.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# 32-byte key (base64) used to encrypt BYOK provider keys at rest.
# Generate: openssl rand -base64 32
# Rotating this makes previously-saved API keys unreadable — see README.
ENCRYPTION_KEY=""

########################################
# GitHub OAuth — sign in / sign up with GitHub
# Create at: https://github.com/settings/developers ("OAuth Apps")
# Callback URL: {NEXT_PUBLIC_APP_URL}/api/auth/callback/github
########################################
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

########################################
# GitHub App — powers the actual PR review integration (separate from the
# OAuth app above). Create at: https://github.com/settings/apps
# Needs: Pull requests (read/write), Contents (read), Metadata (read) permissions
# and a webhook subscribed to "pull_request" + "pull_request_review".
# Webhook URL: {NEXT_PUBLIC_APP_URL}/api/webhooks/github
# Without these, onboarding's GitHub step and the AI review loop are disabled
# but the rest of the product works fine.
########################################
GITHUB_APP_ID=""
GITHUB_APP_SLUG=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_WEBHOOK_SECRET=""

########################################
# Inngest — background jobs (the AI review loop runs here).
# Local dev: leave blank and run `npx inngest-cli@latest dev` — no account needed.
# Production: get keys from https://app.inngest.com
########################################
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

########################################
# Billing — Razorpay. Without these, Pro plan checkout is stubbed
# (Free/BYOK tier works fully without billing).
# https://dashboard.razorpay.com/app/keys
########################################
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_PRO_PLAN_ID=""

########################################
# Transactional email — workspace invites, review-complete notifications.
# Without this, invite links are still created and shown in-app; they just
# aren't emailed automatically.
# https://resend.com/api-keys
########################################
RESEND_API_KEY=""
EMAIL_FROM="ShipFlow AI <notifications@yourdomain.com>"

########################################
# NOTE ON AI PROVIDER KEYS
# ShipFlow is bring-your-own-key: each workspace adds its own OpenAI/Anthropic
# key from Settings → API Keys once it's running. There is no platform-wide
# AI key to set here — that's the point (see ARCHITECTURE.md).
########################################
