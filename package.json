{
  "name": "shipflow-ai",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:generate": "npm run db:generate --workspace=@shipflow/db",
    "db:push": "npm run db:push --workspace=@shipflow/db",
    "db:migrate": "npm run db:migrate --workspace=@shipflow/db",
    "db:seed": "npm run db:seed --workspace=@shipflow/db",
    "db:studio": "npm run db:studio --workspace=@shipflow/db"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "prettier": "^3.4.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}


